/* Requires the Docker Pipeline plugin */
pipeline {
    agent { label 'master' }
    stages {
        stage ('OctoPi') {
            steps {
                build job: 'OctoPi'
            }
        }
        stage ('OctoPi - arm64') {
            steps {
                build job: 'OctoPi - arm64'
            }
        }
        stage ('OctoPi - le potato') {
            steps {
                build job: 'CustomPiOS',
                      parameters: [
                         string(name: 'DISTRO_PATH', value: '/mnt/sda1/OctoPi'),
                         string(name: 'FTP_PUBLISH_PATH', value: '/Distros/OctoPi/debian_lepotato/nightly'),
                         string(name: 'BOARD', value: 'debian_lepotato')
                      ]
            }
         }

    }
}
